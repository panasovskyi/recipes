# Налаштування сервера
PORT=5000
NODE_ENV=development

# Налаштування бази даних PostgreSQL
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=recipes_db
DB_HOST=localhost
DB_PORT=5432

# Ключі для JWT токенів (використовуй довгі випадкові рядки,
# наприклад: openssl rand -base64 32)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Підключення для Prisma (має відповідати значенням вище)
DATABASE_URL="postgresql://your_db_user:your_password@localhost:5432/recipes_db?schema=public"

# Налаштування Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
